# Drupal_Astro_Kit Environment Configuration
# Copy this file to .env and update the values for your environment

# Project Configuration
PROJECT_NAME=your-project-name

# Environment Selection (development/staging/production)
NODE_ENV=development
DRUPAL_ENV=development

# Drupal Backend Configuration
# Development
DRUPAL_SITE_URL=http://drupal-backend.ddev.site
DRUPAL_ADMIN_USER=admin
DRUPAL_ADMIN_PASS=admin
DRUPAL_API_URL=http://localhost:8080

# Staging
# DRUPAL_SITE_URL=https://staging-backend.your-domain.com
# DRUPAL_ADMIN_USER=staging-admin
# DRUPAL_ADMIN_PASS=your-staging-password
# DRUPAL_API_URL=https://staging-api.your-domain.com

# Production
# DRUPAL_SITE_URL=https://backend.your-domain.com
# DRUPAL_ADMIN_USER=prod-admin
# DRUPAL_ADMIN_PASS=your-prod-password
# DRUPAL_API_URL=https://api.your-domain.com

# Astro Frontend Configuration
# Development
PUBLIC_API_BASE_URL=http://localhost:8788
VITE_API_URL=http://localhost:8080
VITE_ANALYTICS_ID=dev-analytics-id

# Staging
# PUBLIC_API_BASE_URL=https://staging-frontend.your-domain.com
# VITE_API_URL=https://staging-api.your-domain.com
# VITE_ANALYTICS_ID=staging-analytics-id

# Production
# PUBLIC_API_BASE_URL=https://frontend.your-domain.com
# VITE_API_URL=https://api.your-domain.com
# VITE_ANALYTICS_ID=prod-analytics-id

# Cloudflare Configuration
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_PROJECT_NAME=your-project-name

# GitHub Actions Secrets
# Add these to your GitHub repository secrets
# PROD_API_URL=https://api.your-domain.com
# STAGING_API_URL=https://staging-api.your-domain.com
# PROD_ANALYTICS_ID=prod-analytics-id
# STAGING_ANALYTICS_ID=staging-analytics-id
# PROD_DDEV_HOST=your-domain.com
# STAGING_DDEV_HOST=staging.your-domain.com
# PROD_DDEV_SSH_KEY=your-prod-ssh-key
# STAGING_DDEV_SSH_KEY=your-staging-ssh-key

# DDEV Configuration
DDEV_HOST=localhost
DDEV_SSH_KEY=~/.ssh/id_rsa

# Optional: Development Tools
# Enable these for local development
ENABLE_XDEBUG=false
ENABLE_MAILHOG=false
ENABLE_ADMINER=false

# Optional: Performance Settings
# Adjust these based on your server capacity
PHP_MEMORY_LIMIT=256M
PHP_MAX_EXECUTION_TIME=60

# Security
SESSION_SECRET=your-session-secret
COOKIE_SECRET=your-cookie-secret
