# Drupal_Astro_Kit Environment Configuration
# Copy this file to .env and update the values for your environment

# Project Configuration
PROJECT_NAME=your-project-name

# Environment Selection (development/staging/production)
NODE_ENV=development
DRUPAL_ENV=development

# Drupal Backend Configuration
# Development
DRUPAL_BASE_URL=http://drupal-backend.ddev.site
DRUPAL_ADMIN_USER=admin
DRUPAL_ADMIN_PASS=admin
DRUPAL_API_URL=

# Staging
# DRUPAL_BASE_URL=https://staging-backend.your-domain.com
# DRUPAL_ADMIN_USER=staging-admin
# DRUPAL_ADMIN_PASS=your-staging-password
# DRUPAL_API_URL=https://staging-api.your-domain.com

# Production
# DRUPAL_BASE_URL=https://backend.your-domain.com
# DRUPAL_ADMIN_USER=prod-admin
# DRUPAL_ADMIN_PASS=your-prod-password
# DRUPAL_API_URL=https://api.your-domain.com

# Astro Frontend Configuration (Static Site)
# The API_BASE_URL is only used at BUILD TIME to fetch content
API_BASE_URL=http://localhost:4321

# Cloudflare Pages Configuration
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_PROJECT_NAME=your-project-name

# GitHub Actions Secrets
# Add these to your GitHub repository secrets
# PROD_API_URL=https://api.your-domain.com
# STAGING_API_URL=https://staging-api.your-domain.com
# PROD_DDEV_HOST=your-domain.com
# STAGING_DDEV_HOST=staging.your-domain.com
# PROD_DDEV_SSH_KEY=your-prod-ssh-key
# STAGING_DDEV_SSH_KEY=your-staging-ssh-key

# DDEV Configuration
DDEV_HOST=localhost
DDEV_SSH_KEY=~/.ssh/id_rsa

# Optional: Development Tools
# Enable these for local development
ENABLE_XDEBUG=false
ENABLE_MAILHOG=false
ENABLE_ADMINER=false

# Optional: Performance Settings
# Adjust these based on your server capacity
PHP_MEMORY_LIMIT=256M
PHP_MAX_EXECUTION_TIME=60
