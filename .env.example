# Drupal_Astro_Kit Environment Configuration
# Copy this file to .env and update the values for your environment

# Project Configuration
PROJECT_NAME=your-project-name

# Environment Selection (development/staging/production)
NODE_ENV=development
DRUPAL_ENV=development

# Drupal Backend Configuration
# Base URL for Drupal site (used for admin access and redirects)
DRUPAL_BASE_URL=http://your-project-name.ddev.site
# Drupal admin credentials (set during setup)
DRUPAL_ADMIN_USER=admin
DRUPAL_ADMIN_PASS=admin
# JSON:API base URL (preferred for API access)
DRUPAL_JSONAPI_URL=http://your-project-name.ddev.site/jsonapi
# DEPRECATED: Use DRUPAL_JSONAPI_URL instead (kept for backward compatibility)
DRUPAL_API_URL=http://your-project-name.ddev.site/jsonapi

# Astro Frontend Configuration (Static Site)
# The API_BASE_URL is only used at BUILD TIME to fetch content from Drupal.
# Astro templates also accept DRUPAL_BASE_URL; keep these aligned.
API_BASE_URL=http://your-project-name.ddev.site
# Drupal alias that should be duplicated at "/" during the Astro build
HOMEPAGE_ALIAS=/home

# Cloudflare Pages Configuration
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_PROJECT_NAME=your-project-name

# Development Tools
# Enable these for local development
ENABLE_XDEBUG=false
ENABLE_MAILHOG=false
ENABLE_ADMINER=false

# Performance Settings
# Adjust these based on your server capacity
PHP_MEMORY_LIMIT=256M
PHP_MAX_EXECUTION_TIME=60
