---
/**
 * Base Layout Component
 * 
 * Shared HTML structure for all pages including:
 * - Document metadata (title, description, Open Graph)
 * - Common styles and scripts
 * - Header/footer structure
 * 
 * @prop title - Page title (required)
 * @prop description - Meta description (optional)
 * @prop canonicalUrl - Canonical URL for SEO (optional)
 */

interface Props {
  title: string;
  description?: string;
  canonicalUrl?: string;
}

const { title, description = '', canonicalUrl } = Astro.props;
const siteUrl = import.meta.env.SITE || 'https://example.com';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />
  
  <!-- Primary Meta Tags -->
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  
  <!-- Canonical URL -->
  {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
  
  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  {description && <meta property="og:description" content={description} />}
  {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
  
  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  {description && <meta name="twitter:description" content={description} />}
  
  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  
  <style is:global>
    /* CSS Reset */
    *, *::before, *::after {
      box-sizing: border-box;
    }
    
    * {
      margin: 0;
    }
    
    html {
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }
    
    body {
      font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
      line-height: 1.6;
      color: #1a1a1a;
      background-color: #fff;
    }
    
    img, picture, video, canvas, svg {
      display: block;
      max-width: 100%;
    }
    
    input, button, textarea, select {
      font: inherit;
    }
    
    p, h1, h2, h3, h4, h5, h6 {
      overflow-wrap: break-word;
    }
    
    a {
      color: #0969da;
      text-decoration: none;
    }
    
    a:hover {
      text-decoration: underline;
    }
  </style>
</head>
<body>
  <header class="site-header">
    <nav class="container">
      <a href="/" class="site-title">Site Title</a>
      <ul class="nav-links">
        <li><a href="/">Home</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
    </nav>
  </header>
  
  <main class="site-main">
    <div class="container">
      <slot />
    </div>
  </main>
  
  <footer class="site-footer">
    <div class="container">
      <p>&copy; {new Date().getFullYear()} Your Site. Built with Astro & Drupal.</p>
    </div>
  </footer>
  
  <style>
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }
    
    .site-header {
      border-bottom: 1px solid #e5e7eb;
      padding: 1rem 0;
    }
    
    .site-header nav {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    
    .site-title {
      font-size: 1.25rem;
      font-weight: 600;
      color: #1a1a1a;
    }
    
    .site-title:hover {
      text-decoration: none;
    }
    
    .nav-links {
      display: flex;
      gap: 1.5rem;
      list-style: none;
      padding: 0;
    }
    
    .site-main {
      padding: 3rem 0;
      min-height: calc(100vh - 200px);
    }
    
    .site-footer {
      border-top: 1px solid #e5e7eb;
      padding: 2rem 0;
      text-align: center;
      color: #666;
      font-size: 0.875rem;
    }
  </style>
</body>
</html>
