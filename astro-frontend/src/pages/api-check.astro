---
// Astro page for JSON:API integration audit
// Tests fetching and rendering Drupal content via JSON:API
// Used by collect_snapshots.js in SSR parity audit

// T018: Ensure jsona deserialization pattern
import Jsona from 'jsona';
import { DrupalJsonApiParams } from 'drupal-jsonapi-params';

// T020: Contract reference: specs/002-drupal-api-config/contracts/openapi.yaml

let pages: any[] = [];
let error: string | null = null;
let corsHeaders: any = {};

try {
  const apiUrl = import.meta.env.DRUPAL_API_URL;
  
  if (!apiUrl) {
    error = 'DRUPAL_API_URL not configured in environment';
  } else {
    // T016: Sparse fieldset example
    // T017: Sorting example
    const params = new DrupalJsonApiParams();
    params.addFilter('status', '1');
    params.addFields('node--page', ['title', 'field_slug', 'field_summary', 'field_body', 'changed']);
    params.addSort('-changed');
    params.addPageLimit(5);

    const queryString = params.getQueryString();
    const endpoint = `${apiUrl}/node/page?${queryString}`;

    console.log(`Fetching from: ${endpoint}`);

    const response = await fetch(endpoint);
    
    // T022: CORS header verification log
    console.log('CORS Headers:', {
      'access-control-allow-origin': response.headers.get('access-control-allow-origin'),
      'access-control-allow-methods': response.headers.get('access-control-allow-methods')
    });
    corsHeaders = {
        origin: response.headers.get('access-control-allow-origin'),
        methods: response.headers.get('access-control-allow-methods')
    };

    if (!response.ok) {
      throw new Error(`HTTP error! status: ${response.status}`);
    }

    const json = await response.json();
    const dataFormatter = new Jsona();
    pages = dataFormatter.deserialize(json);
  }
} catch (err) {
  // T019: Error handling
  error = err instanceof Error ? err.message : 'Unknown error fetching pages';
  console.error('Fetch error:', err);
}
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>API Check - Drupal JSON:API Integration</title>
  <style>
    body {
      font-family: system-ui, -apple-system, sans-serif;
      max-width: 1200px;
      margin: 0 auto;
      padding: 2rem;
      color: #333;
    }
    h1 {
      color: #0969da;
    }
    .status {
      padding: 1rem;
      border-radius: 6px;
      margin: 1rem 0;
    }
    .status.success {
      background-color: #d3f9d8;
      border: 1px solid #51cf66;
      color: #2b8a3e;
    }
    .status.error {
      background-color: #f8d7da;
      border: 1px solid #f5c6cb;
      color: #721c24;
    }
    .pages {
      margin-top: 2rem;
    }
    .page {
      padding: 1rem;
      border: 1px solid #ddd;
      border-radius: 6px;
      margin-bottom: 1rem;
      background-color: #f9f9f9;
    }
    .page h3 {
      margin-top: 0;
    }
    .meta {
        font-size: 0.85rem;
        color: #666;
    }
  </style>
</head>
<body>
  <h1>JSON:API Integration Check</h1>
  
  {error ? (
    <div class="status error">
      <strong>Error:</strong> {error}
    </div>
  ) : (
    <div class="status success">
      <strong>Success:</strong> JSON:API integration working. Fetched {pages.length} page(s).
      <br/>
      <small>CORS Origin: {corsHeaders.origin || 'null'}</small>
    </div>
  )}

  {pages.length > 0 && (
    <div class="pages">
      <h2>Sample Pages</h2>
      {pages.map((page) => (
        <div class="page">
          <h3>{page.title || '(untitled)'}</h3>
          <div class="meta">
            Slug: {page.field_slug} | Changed: {page.changed}
          </div>
          <p>{page.field_summary}</p>
        </div>
      ))}
    </div>
  )}

  <hr />
  <p style="color: #666; font-size: 0.9rem;">
    This page is used by the audit suite to verify Drupal JSON:API integration.
    <br/>
    <!-- T021: Link to quickstart -->
    See <a href="/specs/002-drupal-api-config/quickstart.md">Quickstart Guide</a> for manual validation steps.
  </p>
</body>
</html>
