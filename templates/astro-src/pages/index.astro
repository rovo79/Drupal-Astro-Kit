---
/**
 * Homepage route for Drupal pages (Static Site Generation)
 *
 * Astro does not support an optional rest parameter route for `/`, so we render
 * the homepage via a dedicated `index.astro` route.
 *
 * Resolution rules:
 * - Prefer a Drupal page aliased to `/`.
 * - Fall back to `HOMEPAGE_ALIAS` (default: `/home`).
 */

import Base from '../layouts/Base.astro';
import DrupalPage from '../components/DrupalPage.astro';
import {
  checkApiConnection,
  getHomepageAlias,
  getRenderablePages,
  normalizeAlias,
  type DrupalRenderablePage,
} from '../lib/drupal';

await checkApiConnection();

const pages = await getRenderablePages();
const homepageAlias = getHomepageAlias();

const rootAliasPage = pages.find((p) => p.alias && normalizeAlias(p.alias) === '/');
const configuredHomepagePage = pages.find((p) => p.alias && normalizeAlias(p.alias) === homepageAlias);
const homepagePage: DrupalRenderablePage | undefined = rootAliasPage ?? configuredHomepagePage;

if (!homepagePage) {
  console.warn(`\n⚠ Homepage not found. No page with alias "/" or HOMEPAGE_ALIAS (${homepageAlias}).\n`);
}

const page = homepagePage;
const canonicalUrl = new URL('/', Astro.site).toString();

const bodyText = page?.bodyHtml?.replace(/<[^>]*>/g, '') || '';
const description = bodyText.slice(0, 160).trim() + (bodyText.length > 160 ? '...' : '');
---

<Base
  title={page?.title ?? 'Homepage'}
  description={description || 'Drupal + Astro static site homepage.'}
  canonicalUrl={canonicalUrl}
>
  {page ? (
    <DrupalPage page={page} fallbackTitle="Homepage" />
  ) : (
    <DrupalPage fallbackTitle="Homepage" emptyContentMessage="">
      <Fragment>
        <p>
          No Drupal page was found for <code>/</code> or <code>{homepageAlias}</code>.
        </p>
        <p>
          Create a published “Basic page” in Drupal and set its URL alias to <code>/</code> or <code>{homepageAlias}</code>.
          Refresh the browser while Astro dev is running or rerun <code>npm run build</code> so the new alias is picked up,
          then revisit <code>/</code>.
        </p>
      </Fragment>
    </DrupalPage>
  )}
</Base>
