---
/**
 * Dynamic catch-all route for Drupal pages (Static Site Generation)
 * 
 * At BUILD TIME:
 * 1. Fetches all published pages from Drupal JSON:API
 * 2. Generates static routes based on path aliases
 * 3. Renders HTML for each page
 * 
 * After build, the site has no runtime dependency on Drupal.
 * 
 * Route mapping:
 * - Drupal alias "/about" → Astro slug "about" → dist/about/index.html
 * - Drupal alias "/nested/path" → Astro slug "nested/path" → dist/nested/path/index.html
 */

import Base from '../layouts/Base.astro';
import DrupalPage from '../components/DrupalPage.astro';
import { getRenderablePages, aliasToSlug, checkApiConnection, type DrupalRenderablePage, normalizeAlias } from '../lib/drupal';
import { findReservedAstroRoute } from '../lib/routes';

// Required for static generation
export async function getStaticPaths() {
  // Verify Drupal is accessible before fetching pages
  try {
    await checkApiConnection();
  } catch (error) {
    const message = error instanceof Error ? error.message : 'Unknown error';
    console.error(`\n❌ Build Error: Cannot connect to Drupal JSON:API\n   ${message}\n`);
    console.error('   Make sure DDEV is running: cd drupal-backend && ddev start\n');
    throw new Error(`Drupal JSON:API unreachable: ${message}`);
  }

  // Fetch all published pages
  let pages: DrupalRenderablePage[];
  try {
    pages = await getRenderablePages();
    console.log(`\n✓ Fetched ${pages.length} pages from Drupal JSON:API\n`);
  } catch (error) {
    const message = error instanceof Error ? error.message : 'Unknown error';
    console.error(`\n❌ Build Error: Failed to fetch pages\n   ${message}\n`);
    throw error;
  }

  // Handle empty site
  if (pages.length === 0) {
    console.warn('\n⚠ Warning: No published pages found in Drupal.\n');
    console.warn('  The site will build with no content pages.\n');
    console.warn('  Create pages in Drupal: http://<project>.ddev.site/admin/content\n');
    return [];
  }

  // Check for duplicate aliases (build fails if duplicates found)
  const aliasMap = new Map<string, DrupalRenderablePage[]>();
  for (const page of pages) {
    const rawAlias = page.alias;
    if (!rawAlias || rawAlias.trim() === '') {
      continue;
    }

    const alias = normalizeAlias(rawAlias);
    if (!aliasMap.has(alias)) {
      aliasMap.set(alias, []);
    }
    aliasMap.get(alias)!.push(page);
  }

  const duplicates = Array.from(aliasMap.entries()).filter(([, pages]) => pages.length > 1);
  if (duplicates.length > 0) {
    console.error('\n❌ Build Error: Duplicate path aliases detected!\n');
    for (const [alias, pages] of duplicates) {
      console.error(`   Alias "${alias}" is used by:`);
      for (const page of pages) {
        console.error(`     - "${page.title}" (ID: ${page.id})`);
      }
    }
    console.error('\n   Fix these duplicates in Drupal before building.\n');
    throw new Error('Duplicate path aliases detected. Cannot generate static routes.');
  }

  // Generate static paths for non-reserved Drupal aliases.
  const paths: Array<{
    params: { slug: string };
    props: { page: DrupalRenderablePage };
  }> = [];
  let skippedCount = 0;
  let skippedRootAliasCount = 0;

  for (const page of pages) {
    const alias = page.alias;
    
    // Skip pages without aliases (they can't be routed)
    if (alias === undefined || alias === null || alias.trim() === '') {
      console.warn(`  ⚠ Skipping page "${page.title}" (ID: ${page.id}) - no path alias`);
      skippedCount++;
      continue;
    }

    const normalizedAlias = normalizeAlias(alias);
    if (normalizedAlias === '/') {
      skippedRootAliasCount++;
      continue;
    }

    const reservedRoute = findReservedAstroRoute(normalizedAlias);
    if (reservedRoute) {
      throw new Error(
        `Drupal alias "${normalizedAlias}" collides with reserved Astro route ${reservedRoute.source}. Remove or rename the Drupal page "${page.title}" (ID: ${page.id}).`,
      );
    }

    const slug = aliasToSlug(alias);
    if (!slug || slug.length === 0) {
      console.warn(`  ⚠ Skipping page "${page.title}" (ID: ${page.id}) - invalid slug derived from alias "${alias}"`);
      skippedCount++;
      continue;
    }

    paths.push({
      params: { slug },
      props: { page },
    });
  }

  if (skippedCount > 0) {
    console.warn(`\n⚠ ${skippedCount} page(s) skipped (missing path aliases)\n`);
  }

  if (skippedRootAliasCount > 0) {
    console.log(`  Root alias pages handled by src/pages/index.astro: ${skippedRootAliasCount}`);
  }

  console.log(`  Routes generated: ${paths.length}`);
  for (const p of paths) {
    const displaySlug = `/${p.params.slug}`;
    console.log(`    ${displaySlug} → ${p.props.page.title}`);
  }
  console.log('');

  return paths;
}

// Get page data from props (passed from getStaticPaths)
interface Props {
  page: DrupalRenderablePage;
}

const { page } = Astro.props;

// Build canonical URL
const slug = Astro.params.slug;
const canonicalPath = `/${slug}`;
const canonicalUrl = new URL(canonicalPath, Astro.site).toString();

// Extract description from body (first 160 chars of text content)
const bodyText = page.bodyHtml?.replace(/<[^>]*>/g, '') || '';
const description = bodyText.slice(0, 160).trim() + (bodyText.length > 160 ? '...' : '');
---

<Base title={page.title} description={description} canonicalUrl={canonicalUrl}>
  <DrupalPage page={page} fallbackTitle={page.title} />
</Base>
