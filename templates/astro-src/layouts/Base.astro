---
/**
 * Base HTML Layout
 * 
 * Shared layout component for all pages.
 * Provides consistent HTML structure, meta tags, and styling.
 */

interface Props {
  title: string;
  description?: string;
  canonicalUrl?: string;
}

import Navigation from '../components/Navigation.astro';
import { getMenu } from '../lib/drupal';

const { 
  title, 
  description = 'A page powered by Drupal and Astro',
  canonicalUrl 
} = Astro.props;

const currentPath = Astro.url.pathname;
const mainMenu = await getMenu('main', { required: true });
const footerMenu = await getMenu('footer', { required: false });
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    
    <!-- Icons -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    
    <style is:global>
      /* CSS Reset */
      *, *::before, *::after {
        box-sizing: border-box;
      }
      
      * {
        margin: 0;
      }
      
      html {
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }
      
      body {
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        line-height: 1.6;
        color: #1a1a1a;
        background: #fff;
      }
      
      img, picture, video, canvas, svg {
        display: block;
        max-width: 100%;
      }
      
      a {
        color: #0969da;
        text-decoration: none;
      }
      
      a:hover {
        text-decoration: underline;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <header class="site-header">
        <Navigation items={mainMenu} label="Primary" currentPath={currentPath} className="main-navigation" />
      </header>
      
      <main>
        <slot />
      </main>
      
      <footer class="site-footer">
        {footerMenu.length > 0 && (
          <Navigation items={footerMenu} label="Footer" currentPath={currentPath} className="footer-navigation" />
        )}
        <p>Built with <a href="https://www.drupal.org/" target="_blank" rel="noopener">Drupal</a> + <a href="https://astro.build/" target="_blank" rel="noopener">Astro</a></p>
      </footer>
    </div>
    
    <style>
      .container {
        max-width: 800px;
        margin: 0 auto;
        padding: 2rem 1rem;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }
      
      .site-header {
        padding-bottom: 2rem;
        border-bottom: 1px solid #e5e7eb;
        margin-bottom: 2rem;
      }

      .main-navigation :global(.navigation-list) {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        align-items: center;
      }

      .main-navigation :global(.navigation-item) {
        position: relative;
      }

      .main-navigation :global(.navigation-sublist) {
        margin-left: 0;
        padding-left: 0.75rem;
      }

      .main-navigation :global(.navigation-link) {
        font-weight: 500;
      }
      
      main {
        flex: 1;
      }
      
      .site-footer {
        margin-top: 3rem;
        padding-top: 2rem;
        border-top: 1px solid #e5e7eb;
        color: #666;
        font-size: 0.875rem;
        text-align: center;
      }

      .footer-navigation {
        margin-bottom: 1rem;
      }

      .footer-navigation :global(.navigation-list) {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 1rem;
      }
    </style>
  </body>
</html>
